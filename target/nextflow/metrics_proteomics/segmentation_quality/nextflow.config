manifest {
  name = 'metrics_proteomics/segmentation_quality'
  mainScript = 'main.nf'
  nextflowVersion = '!>=20.12.1-edge'
  version = 'build_main'
  description = 'Scores segmentation without reference masks, using four properties the data\nmust satisfy if cells were delineated correctly:\n\n- `dapi_positive_ratio` - fraction of objects containing nuclear signal.\n  Every segmented cell should have a nucleus, so a low value means objects are\n  being produced that are not cells. Higher is better.\n- `replicate_correlation` - agreement between nuclear stains repeated across\n  imaging cycles. They image the same physical nuclei, so disagreement is\n  direct evidence of mis-segmentation or mis-registration. Higher is better.\n- `median_replicate_cv` - the same signal seen per cell: spread across the\n  repeated stains within each cell. Lower is better.\n- `mutually_exclusive_coexpression_ratio` - how often cells are co-positive\n  for markers restricted to incompatible lineages, as a fraction of cells\n  positive for either. Merged or bled masks raise it. Lower is better.\n- `spillover_ratio` - intensity in negative cells adjacent to a positive cell\n  against negative cells that are not adjacent. Over-expanded masks raise it\n  above 1. Lower is better.\n\nPositivity is set per marker by Otsu on log1p intensity rather than a fixed\ncutoff, so the metrics survive a change of normalization or intensity scale.\nCo-expression is NaN unless `--exclusive_pairs` is given, since the correct\npairs depend on the panel.\n'
}

process.container = 'nextflow/bash:latest'

// detect tempdir
tempDir = java.nio.file.Paths.get(
  System.getenv('NXF_TEMP') ?:
    System.getenv('VIASH_TEMP') ?: 
    System.getenv('TEMPDIR') ?: 
    System.getenv('TMPDIR') ?: 
    '/tmp'
).toAbsolutePath()

profiles {
  no_publish {
    process {
      withName: '.*' {
        publishDir = [
          enabled: false
        ]
      }
    }
  }
  mount_temp {
    docker.temp            = tempDir
    podman.temp            = tempDir
    charliecloud.temp      = tempDir
  }
  docker {
    docker.enabled         = true
    // docker.userEmulation   = true
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    docker.enabled         = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  podman {
    podman.enabled         = true
    docker.enabled         = false
    singularity.enabled    = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  shifter {
    shifter.enabled        = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    charliecloud.enabled   = false
  }
  charliecloud {
    charliecloud.enabled   = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
  }
}

process{
  withLabel: lowmem { memory = 20.Gb }
  withLabel: midmem { memory = 50.Gb }
  withLabel: highmem { memory = 100.Gb }
  withLabel: lowcpu { cpus = 5 }
  withLabel: midcpu { cpus = 15 }
  withLabel: highcpu { cpus = 30 }
  withLabel: lowtime { time = 1.h }
  withLabel: midtime { time = 4.h }
  withLabel: hightime { time = 8.h }
  withLabel: veryhightime { time = 24.h }
}


