manifest {
  name = 'metrics_proteomics/technical_covariates'
  mainScript = 'main.nf'
  nextflowVersion = '!>=20.12.1-edge'
  version = 'build_main'
  description = 'Aggregation and normalization should leave per-cell profiles reflecting\nbiology rather than how large a cell was or how bright its channel is.\n\nThe area metrics are reported on **both** layers, suffixed `_counts` and\n`_normalized`. The raw layer asks whether aggregation introduced area\ndependence; the normalized layer asks whether normalization removed it. Only\nthe raw layer can see the aggregation axis: per-cell total normalization\ndivides out exactly the area scaling that `sum` aggregation creates, so\nevaluating the normalized layer alone reports `mean` and `sum` as identical.\n\n- `variance_explained_by_covariate_{counts,normalized}` - mean R² of\n  expression regressed on cell area, linear and logged. Lower is better.\n- `max_marker_variance_explained_by_covariate_{counts,normalized}` - the worst\n  marker, so a single area-driven channel is not hidden by the panel average.\n  Lower is better.\n- `covariate_pc_correlation_{counts,normalized}` - mean absolute correlation\n  between the leading principal components and area. Lower is better.\n- `mean_variance_correlation` - dependence of per-marker variance on\n  per-marker mean, which a variance-stabilising transform should remove.\n  Lower is better.\n- `marker_variance_evenness` - Shannon entropy of the per-marker variance\n  shares, normalised to 0-1. High means variance is spread across the panel;\n  low means a few bright markers dominate. Higher is better.\n\nAdapted from the scverse hackathon `sprot` prototype\n(`metrics/technical_correction.py` and `metrics/protein_contribution.py`).\nCell area replaces the single-cell covariates that prototype assumed\n(`total_counts`, `pct_mito`, `batch`), none of which exist here; PCA is done\nby SVD rather than scikit-learn to avoid the extra dependency.\n'
}

process.container = 'nextflow/bash:latest'

// detect tempdir
tempDir = java.nio.file.Paths.get(
  System.getenv('NXF_TEMP') ?:
    System.getenv('VIASH_TEMP') ?: 
    System.getenv('TEMPDIR') ?: 
    System.getenv('TMPDIR') ?: 
    '/tmp'
).toAbsolutePath()

profiles {
  no_publish {
    process {
      withName: '.*' {
        publishDir = [
          enabled: false
        ]
      }
    }
  }
  mount_temp {
    docker.temp            = tempDir
    podman.temp            = tempDir
    charliecloud.temp      = tempDir
  }
  docker {
    docker.enabled         = true
    // docker.userEmulation   = true
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    docker.enabled         = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  podman {
    podman.enabled         = true
    docker.enabled         = false
    singularity.enabled    = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  shifter {
    shifter.enabled        = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    charliecloud.enabled   = false
  }
  charliecloud {
    charliecloud.enabled   = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
  }
}

process{
  withLabel: lowmem { memory = 20.Gb }
  withLabel: midmem { memory = 50.Gb }
  withLabel: highmem { memory = 100.Gb }
  withLabel: lowcpu { cpus = 5 }
  withLabel: midcpu { cpus = 15 }
  withLabel: highcpu { cpus = 30 }
  withLabel: lowtime { time = 1.h }
  withLabel: midtime { time = 4.h }
  withLabel: hightime { time = 8.h }
  withLabel: veryhightime { time = 24.h }
}


